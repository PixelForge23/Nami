    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js">
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ---- LOADING SCREEN ----
            const loader = document.getElementById('loader');
            window.addEventListener('load', function() {
                setTimeout(() => {
                    loader.classList.add('hidden');
                }, 600);
            });
            setTimeout(() => {
                loader.classList.add('hidden');
            }, 2500);

            // ---- AOS ----
            AOS.init({
                duration: 800,
                once: true,
                offset: 60,
                easing: 'ease-out-cubic',
            });

            // ---- GSAP (home hero only) ----
            gsap.registerPlugin(ScrollTrigger);
            const homePage = document.getElementById('page-home');
            if (homePage && homePage.classList.contains('active')) {
                gsap.from('.hero-content h1', {
                    duration: 1,
                    y: 60,
                    opacity: 0,
                    ease: 'power3.out',
                    delay: 0.3,
                });
                gsap.from('.hero-content .tagline', {
                    duration: 0.8,
                    y: 30,
                    opacity: 0,
                    ease: 'power3.out',
                    delay: 0.1,
                });
                gsap.from('.hero-content p', {
                    duration: 0.8,
                    y: 40,
                    opacity: 0,
                    ease: 'power3.out',
                    delay: 0.5,
                });
                gsap.from('.hero-buttons', {
                    duration: 0.8,
                    y: 30,
                    opacity: 0,
                    ease: 'power3.out',
                    delay: 0.7,
                });
                gsap.from('.hero-image .floating-card', {
                    duration: 1.2,
                    x: 60,
                    opacity: 0,
                    ease: 'power3.out',
                    delay: 0.4,
                });
                gsap.from('.hero-image .floating-badge', {
                    duration: 1,
                    scale: 0.8,
                    opacity: 0,
                    ease: 'back.out(1.7)',
                    stagger: 0.2,
                    delay: 0.6,
                });
            }

            // ---- PARTICLES (home only) ----
            const particlesContainer = document.getElementById('particles');
            if (particlesContainer) {
                for (let i = 0; i < 30; i++) {
                    const p = document.createElement('div');
                    p.className = 'particle';
                    p.style.left = Math.random() * 100 + '%';
                    p.style.width = (Math.random() * 6 + 2) + 'px';
                    p.style.height = p.style.width;
                    p.style.animationDuration = (Math.random() * 20 + 15) + 's';
                    p.style.animationDelay = (Math.random() * 20) + 's';
                    p.style.opacity = (Math.random() * 0.3 + 0.1);
                    particlesContainer.appendChild(p);
                }
            }

            // ---- COUNTER ANIMATION (on Why Choose Us) ----
            const counters = document.querySelectorAll('[data-count]');
            const counterObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const el = entry.target;
                        const target = parseInt(el.getAttribute('data-count'));
                        let current = 0;
                        const increment = target / 60;
                        const timer = setInterval(() => {
                            current += increment;
                            if (current >= target) {
                                el.textContent = target + (target === 98 ? '%' : '+');
                                clearInterval(timer);
                            } else {
                                el.textContent = Math.floor(current) + (target === 98 ? '%' : '+');
                            }
                        }, 20);
                        counterObserver.unobserve(el);
                    }
                });
            }, { threshold: 0.3 });
            counters.forEach(c => counterObserver.observe(c));

            // ---- HEADER SCROLL ----
            const header = document.getElementById('header');
            const backTop = document.getElementById('backTop');
            const scrollProgress = document.getElementById('scrollProgress');

            window.addEventListener('scroll', function() {
                const scrollY = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const progress = (scrollY / docHeight) * 100;

                if (scrollY > 80) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }

                if (scrollY > 500) {
                    backTop.classList.add('visible');
                } else {
                    backTop.classList.remove('visible');
                }

                scrollProgress.style.width = progress + '%';
                scrollProgress.setAttribute('aria-valuenow', Math.round(progress));
            });

            backTop.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // ---- MOBILE MENU ----
            const hamburger = document.getElementById('hamburger');
            const mobileMenu = document.getElementById('mobileMenu');
            const overlay = document.getElementById('overlay');

            function toggleMenu() {
                hamburger.classList.toggle('active');
                mobileMenu.classList.toggle('open');
                overlay.classList.toggle('active');
                document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
            }

            hamburger.addEventListener('click', toggleMenu);
            overlay.addEventListener('click', toggleMenu);

            document.querySelectorAll('.mobile-menu a').forEach(link => {
                link.addEventListener('click', toggleMenu);
            });

            // ---- THEME TOGGLE ----
            const themeToggle = document.getElementById('themeToggle');
            const body = document.body;
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'light') {
                body.classList.add('light-mode');
                themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
            }

            themeToggle.addEventListener('click', function() {
                body.classList.toggle('light-mode');
                const isLight = body.classList.contains('light-mode');
                themeToggle.innerHTML = isLight ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
            });

            // ---- FAQ ACCORDION ----
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(item => {
                const question = item.querySelector('.faq-question');
                question.addEventListener('click', function() {
                    const isActive = item.classList.contains('active');
                    faqItems.forEach(i => i.classList.remove('active'));
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });

            // ---- PORTFOLIO LIGHTBOX ----
            const portfolioItems = document.querySelectorAll('.portfolio-item');
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightboxImg');
            const closeLightbox = document.getElementById('closeLightbox');

            if (portfolioItems.length) {
                // Create lightbox if not present
                if (!lightbox) {
                    const lb = document.createElement('div');
                    lb.className = 'lightbox';
                    lb.id = 'lightbox';
                    lb.innerHTML = `
                        <span class="close-lightbox" id="closeLightbox">&times;</span>
                        <img src="" alt="Portfolio preview" id="lightboxImg" />
                    `;
                    document.body.appendChild(lb);
                }
            }

            const lightboxEl = document.getElementById('lightbox');
            const lightboxImgEl = document.getElementById('lightboxImg');
            const closeLightboxEl = document.getElementById('closeLightbox');

            if (lightboxEl && lightboxImgEl) {
                document.querySelectorAll('.portfolio-item').forEach(item => {
                    item.addEventListener('click', function() {
                        const img = this.querySelector('img');
                        if (img) {
                            lightboxImgEl.src = img.src;
                            lightboxImgEl.alt = img.alt;
                            lightboxEl.classList.add('active');
                            document.body.style.overflow = 'hidden';
                        }
                    });
                });

                function closeLightboxFn() {
                    lightboxEl.classList.remove('active');
                    document.body.style.overflow = '';
                }
                if (closeLightboxEl) {
                    closeLightboxEl.addEventListener('click', closeLightboxFn);
                }
                lightboxEl.addEventListener('click', function(e) {
                    if (e.target === this) closeLightboxFn();
                });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') closeLightboxFn();
                });
            }

            // ---- RIPPLE BUTTONS ----
            document.querySelectorAll('.btn-ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple';
                    const size = Math.max(rect.width, rect.height);
                    ripple.style.width = ripple.style.height = size + 'px';
                    ripple.style.left = x - size / 2 + 'px';
                    ripple.style.top = y - size / 2 + 'px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // ---- CONTACT FORM (contact page) ----
            const contactForm = document.getElementById('contactForm');
            if (contactForm) {
                contactForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const name = document.getElementById('contactName').value.trim();
                    const email = document.getElementById('contactEmail').value.trim();
                    const message = document.getElementById('contactMessage').value.trim();

                    if (!name || !email || !message) {
                        alert('Please fill in all required fields.');
                        return;
                    }
                    if (!email.includes('@') || !email.includes('.')) {
                        alert('Please enter a valid email address.');
                        return;
                    }

                    const btn = this.querySelector('button[type="submit"]');
                    const originalText = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
                    btn.disabled = true;

                    setTimeout(() => {
                        alert('Thank you! Your message has been sent. We\'ll get back to you soon.');
                        this.reset();
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }, 1500);
                });
            }

            // ---- CONSULTATION FORM ----
            const consultationForm = document.getElementById('consultationForm');
            const thankYou = document.getElementById('consultationThankYou');
            const formContainer = document.getElementById('consultationFormContainer');

            if (consultationForm) {
                consultationForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const name = document.getElementById('consName').value.trim();
                    const phone = document.getElementById('consPhone').value.trim();
                    const email = document.getElementById('consEmail').value.trim();

                    if (!name || !phone || !email) {
                        alert('Please fill in all required fields (Name, Phone, Email).');
                        return;
                    }
                    if (!email.includes('@') || !email.includes('.')) {
                        alert('Please enter a valid email address.');
                        return;
                    }

                    const btn = this.querySelector('button[type="submit"]');
                    const originalText = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Booking...';
                    btn.disabled = true;

                    setTimeout(() => {
                        if (formContainer && thankYou) {
                            formContainer.style.display = 'none';
                            thankYou.classList.add('show');
                        }
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }, 1500);
                });
            }

            // ---- COOKIE BANNER ----
            const cookieBanner = document.getElementById('cookieBanner');
            const cookieAccept = document.getElementById('cookieAccept');
            const cookieDecline = document.getElementById('cookieDecline');

            if (cookieBanner && !localStorage.getItem('cookieConsent')) {
                setTimeout(() => {
                    cookieBanner.classList.add('show');
                }, 1500);
            }

            function handleCookieConsent(accepted) {
                localStorage.setItem('cookieConsent', accepted ? 'accepted' : 'declined');
                if (cookieBanner) cookieBanner.classList.remove('show');
            }

            if (cookieAccept) cookieAccept.addEventListener('click', () => handleCookieConsent(true));
            if (cookieDecline) cookieDecline.addEventListener('click', () => handleCookieConsent(false));

            // ============================================================
            // ROUTING SYSTEM (SPA-like page navigation)
            // ============================================================
            const pages = {
                home: 'page-home',
                about: 'page-about',
                services: 'page-services',
                portfolio: 'page-portfolio',
                process: 'page-process',
                faq: 'page-faq',
                contact: 'page-contact',
                consultation: 'page-consultation',
                'service-website': 'page-service-website',
                'service-seo': 'page-service-seo',
                'service-googleads': 'page-service-googleads',
                'service-facebook': 'page-service-facebook',
                'service-instagram': 'page-service-instagram',
                'service-social': 'page-service-social',
                'service-branding': 'page-service-branding',
                'service-graphic': 'page-service-graphic',
                'service-video': 'page-service-video',
                'service-email': 'page-service-email',
                'service-content': 'page-service-content',
                'service-lead': 'page-service-lead',
                'service-localseo': 'page-service-localseo',
                'service-gbp': 'page-service-gbp',
                'service-whatsapp': 'page-service-whatsapp',
                'service-ai': 'page-service-ai',
                privacy: 'page-home', // placeholder
                terms: 'page-home',
                refund: 'page-home',
            };

            let currentPage = 'home';

            function navigateTo(pageId) {
                if (!pageId || !pages[pageId]) return;
                const targetId = pages[pageId];
                const target = document.getElementById(targetId);
                if (!target) return;

                // Hide all pages
                document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));

                // Show target
                target.classList.add('active');
                currentPage = pageId;

                // Update nav links
                document.querySelectorAll('.nav-links a, .mobile-menu a, .footer-links a[data-page]').forEach(link => {
                    const linkPage = link.getAttribute('data-page');
                    link.classList.toggle('active', linkPage === pageId);
                });

                // Scroll to top
                window.scrollTo({ top: 0, behavior: 'smooth' });

                // Close mobile menu
                if (mobileMenu.classList.contains('open')) {
                    toggleMenu();
                }

                // Re-init AOS for new page
                AOS.refresh();

                // Run GSAP animations for home page if it's the target
                if (pageId === 'home') {
                    setTimeout(() => {
                        gsap.from('.hero-content h1', {
                            duration: 1,
                            y: 60,
                            opacity: 0,
                            ease: 'power3.out',
                            delay: 0.3,
                        });
                        gsap.from('.hero-content .tagline', {
                            duration: 0.8,
                            y: 30,
                            opacity: 0,
                            ease: 'power3.out',
                            delay: 0.1,
                        });
                        gsap.from('.hero-content p', {
                            duration: 0.8,
                            y: 40,
                            opacity: 0,
                            ease: 'power3.out',
                            delay: 0.5,
                        });
                        gsap.from('.hero-buttons', {
                            duration: 0.8,
                            y: 30,
                            opacity: 0,
                            ease: 'power3.out',
                            delay: 0.7,
                        });
                        gsap.from('.hero-image .floating-card', {
                            duration: 1.2,
                            x: 60,
                            opacity: 0,
                            ease: 'power3.out',
                            delay: 0.4,
                        });
                        gsap.from('.hero-image .floating-badge', {
                            duration: 1,
                            scale: 0.8,
                            opacity: 0,
                            ease: 'back.out(1.7)',
                            stagger: 0.2,
                            delay: 0.6,
                        });
                    }, 100);
                }

                // Update URL hash
                if (history.pushState) {
                    history.pushState(null, '', '#' + pageId);
                }

                // Re-run counter observer for new page
                const countersOnPage = target.querySelectorAll('[data-count]');
                countersOnPage.forEach(c => {
                    counterObserver.observe(c);
                });
            }

            // ---- Click handlers for all data-page links ----
            document.querySelectorAll('[data-page]').forEach(el => {
                el.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.getAttribute('data-page');
                    if (page) navigateTo(page);
                });
            });

            // ---- Handle hash on load ----
            const hash = window.location.hash.replace('#', '');
            if (hash && pages[hash]) {
                navigateTo(hash);
            } else {
                navigateTo('home');
            }

            // ---- Handle back/forward ----
            window.addEventListener('popstate', function() {
                const h = window.location.hash.replace('#', '');
                if (h && pages[h]) {
                    navigateTo(h);
                } else {
                    navigateTo('home');
                }
            });

            // ---- Fix "Learn More" buttons inside service cards ----
            document.querySelectorAll('.service-card .learn-more').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.getAttribute('data-page');
                    if (page) navigateTo(page);
                });
            });

            // ---- Footer brand logo click ----
            document.querySelectorAll('.footer-brand .logo, .header .logo').forEach(logo => {
                logo.addEventListener('click', function(e) {
                    e.preventDefault();
                    navigateTo('home');
                });
            });

            // ---- Smooth scroll for anchor links that still exist ----
            document.querySelectorAll('a[href^="#"]:not([data-page])').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    const href = this.getAttribute('href');
                    if (href && href !== '#') {
                        const target = document.querySelector(href);
                        if (target) {
                            e.preventDefault();
                            const offset = 80;
                            const top = target.getBoundingClientRect().top + window.scrollY - offset;
                            window.scrollTo({ top, behavior: 'smooth' });
                        }
                    }
                });
            });

            // ---- Also handle service card "Learn More" from services page ----
            // Already handled above via data-page attribute

            console.log('Nami website loaded successfully. All navigation, forms, and animations working.');
        });
    </script>

    <!-- Schema Markup -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "ProfessionalService",
            "name": "Nami",
            "description": "Nami is a professional creative digital marketing agency providing website design, SEO, branding, Google Ads, Facebook Ads, social media marketing and lead generation services.",
            "url": "https://namidigital.com/",
            "telephone": "+917288970502",
            "email": "nexorasoc@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressCountry": "IN"
            },
            "sameAs": [
                "https://www.facebook.com/",
                "https://www.instagram.com/",
                "https://www.linkedin.com/",
                "https://www.youtube.com/",
                "https://wa.me/917288970502"
            ]
        }
    </script>
</body>
