                <h2>
                    <strong>Data‑driven strategies</strong> that turn visitors into loyal customers —
                    built for the modern digital landscape.
                </h2>

                <p>
                    From SEO and social media to paid advertising and branding, we deliver innovative
                    digital marketing solutions that help businesses attract customers, boost engagement,
                    and achieve measurable results.
                </p>

                <div class="hero-buttons">
                    <a data-page="consultation" class="btn btn-primary btn-ripple">
                        Get a Free Consultation <i class="fas fa-arrow-right"></i>
                    </a>
                    <a data-page="services" class="btn btn-secondary">
                        View Our Services <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>

            <!-- ─── IMAGE ─── -->
            <div class="hero-image" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
                <div class="floating-card">
                    <img
                    src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80"
                    alt="Marketing team collaborating in modern office"
                    loading="lazy"
                    width="800"
                    height="533"
                    />
                </div>
                <div class="floating-badge b1">
                    <i class="fas fa-chart-line"></i>
                    <span>+250% Growth</span>
                </div>
                <div class="floating-badge b2">
                    <i class="fas fa-star"></i>
                    <span>4.9/5 Rating</span>
                </div>
            </div>

        </div>

        <!-- Scroll Indicator -->
        <div class="scroll-indicator" aria-hidden="true">
            <div class="mouse"></div>
            <span>Scroll</span>
        </div>
    </section>

</body>
