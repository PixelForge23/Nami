<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nami | Creative Digital Marketing Agency</title>
    <meta name="description" content="Nami is a professional creative digital marketing agency providing website design, SEO, branding, Google Ads, Facebook Ads, social media marketing and lead generation services." />
    <meta name="keywords" content="Digital Marketing Agency, SEO Services, Website Design, Website Development, Social Media Marketing, Facebook Ads, Google Ads, Instagram Marketing, Lead Generation, Branding Agency, Local SEO, Digital Marketing Company, Business Growth, Graphic Design, Video Editing, Content Marketing, Google Business Profile" />
    <link rel="canonical" href="https://namidigital.com/" />

    <!-- Open Graph -->
    <meta property="og:title" content="Nami | Creative Digital Marketing Agency" />
    <meta property="og:description" content="Nami is a professional creative digital marketing agency providing website design, SEO, branding, Google Ads, Facebook Ads, social media marketing and lead generation services." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://namidigital.com/" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1200&h=630&fit=crop" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nami | Creative Digital Marketing Agency" />
    <meta name="twitter:description" content="Professional creative digital marketing agency providing website design, SEO, branding, and more." />
    <meta name="twitter:image" content="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1200&h=630&fit=crop" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌊%3C/text%3E%3C/svg%3E" />

    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- AOS -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <style>
        /* ============================================================
           ROOT VARIABLES
        ============================================================ */
        :root {
            --primary: #007BFF;
            --primary-dark: #0056b3;
            --primary-light: #4da3ff;
            --dark: #0a0a1a;
            --dark-card: #111128;
            --dark-surface: #1a1a3a;
            --white: #ffffff;
            --light-gray: #f0f4ff;
            --text-dark: #1a1a2e;
            --text-light: #f0f4ff;
            --text-muted: #a0aec0;
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.12);
            --shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            --shadow-light: 0 10px 40px rgba(0, 123, 255, 0.15);
            --radius: 20px;
            --radius-sm: 12px;
            --transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --font: 'Poppins', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 80px;
        }

        body {
            font-family: var(--font);
            background: var(--dark);
            color: var(--text-light);
            overflow-x: hidden;
            line-height: 1.7;
        }

        a {
            text-decoration: none;
            color: inherit;
        }
        ul {
            list-style: none;
        }
        img {
            max-width: 100%;
            display: block;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ============================================================
           LOADING SCREEN
        ============================================================ */
        #loader {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: var(--dark);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }
        #loader.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        #loader .logo-load {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        #loader .logo-load .main {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: -2px;
            background: linear-gradient(135deg, var(--primary), #00d4ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        #loader .logo-load .sub {
            font-size: 1rem;
            letter-spacing: 6px;
            color: var(--text-muted);
            margin-top: 4px;
        }
        #loader .logo-load .tagline {
            font-size: 0.8rem;
            letter-spacing: 3px;
            color: var(--primary);
            margin-top: 8px;
        }
        #loader .loader-bar {
            margin-top: 30px;
            width: 200px;
            height: 3px;
            background: var(--dark-surface);
            border-radius: 10px;
            overflow: hidden;
        }
        #loader .loader-bar::after {
            content: '';
            display: block;
            width: 40%;
            height: 100%;
            background: linear-gradient(90deg, var(--primary), #00d4ff);
            border-radius: 10px;
            animation: load-progress 1.4s ease-in-out infinite;
        }

        @keyframes load-progress {
            0% {
                transform: translateX(-100%);
            }
            100% {
                transform: translateX(350%);
            }
        }

        /* ============================================================
           HEADER / NAVIGATION
        ============================================================ */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 9999;
            padding: 14px 0;
            transition: background 0.4s ease, box-shadow 0.4s ease, padding 0.4s ease;
            background: transparent;
        }
        .header.scrolled {
            background: rgba(10, 10, 26, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
            padding: 10px 0;
        }
        .header .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
        }
        .logo .logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }
        .logo .logo-text .main {
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: -1px;
            color: var(--white);
        }
        .logo .logo-text .main span {
            color: var(--primary);
        }
        .logo .logo-text .sub {
            font-size: 0.6rem;
            letter-spacing: 4px;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .logo .logo-text .tagline {
            font-size: 0.55rem;
            letter-spacing: 2px;
            color: var(--primary);
            text-transform: uppercase;
        }
        .logo .logo-icon {
            font-size: 2.2rem;
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .nav-links a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-light);
            position: relative;
            padding: 4px 0;
            transition: color 0.3s;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--primary);
            transition: width 0.3s ease;
        }
        .nav-links a:hover,
        .nav-links a.active {
            color: var(--primary);
        }
        .nav-links a:hover::after,
        .nav-links a.active::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .theme-toggle {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 50%;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            font-size: 1.1rem;
            cursor: pointer;
            transition: 0.3s;
            backdrop-filter: blur(8px);
        }
        .theme-toggle:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 4px;
            z-index: 100;
        }
        .hamburger span {
            display: block;
            width: 28px;
            height: 2.5px;
            background: var(--text-light);
            border-radius: 4px;
            transition: 0.3s ease;
        }
        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }
        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }
        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 300px;
            height: 100vh;
            background: rgba(10, 10, 26, 0.98);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            padding: 80px 32px 40px;
            transition: right 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 9998;
            display: flex;
            flex-direction: column;
            gap: 16px;
            border-left: 1px solid var(--glass-border);
            overflow-y: auto;
        }
        .mobile-menu.open {
            right: 0;
        }
        .mobile-menu a {
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-light);
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: 0.3s;
        }
        .mobile-menu a:hover {
            color: var(--primary);
            padding-left: 12px;
        }
        .mobile-menu .mobile-social {
            margin-top: auto;
            display: flex;
            gap: 16px;
        }
        .mobile-menu .mobile-social a {
            border: none;
            padding: 0;
            font-size: 1.4rem;
            color: var(--text-muted);
        }
        .mobile-menu .mobile-social a:hover {
            color: var(--primary);
            padding-left: 0;
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9997;
            opacity: 0;
            visibility: hidden;
            transition: 0.4s;
        }
        .overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* ============================================================
           BUTTONS
        ============================================================ */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 34px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            transition: 0.3s ease;
            position: relative;
            overflow: hidden;
            font-family: var(--font);
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), #0056b3);
            color: #fff;
            box-shadow: 0 8px 30px rgba(0, 123, 255, 0.35);
        }
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 40px rgba(0, 123, 255, 0.5);
        }
        .btn-secondary {
            background: transparent;
            color: var(--text-light);
            border: 2px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(4px);
        }
        .btn-secondary:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: translateY(-3px);
            background: rgba(0, 123, 255, 0.05);
        }
        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: #fff;
            box-shadow: 0 8px 30px rgba(16, 185, 129, 0.35);
        }
        .btn-success:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 40px rgba(16, 185, 129, 0.5);
        }
        .btn-ripple {
            position: relative;
            overflow: hidden;
        }
        .btn-ripple .ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: scale(0);
            animation: ripple-anim 0.6s linear;
            pointer-events: none;
        }
        @keyframes ripple-anim {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* ============================================================
           PAGE SYSTEM (SPA-like routing)
        ============================================================ */
        .page {
            display: none;
            animation: fadeInPage 0.5s ease forwards;
        }
        .page.active {
            display: block;
        }
        @keyframes fadeInPage {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============================================================
           HERO (Home)
        ============================================================ */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 120px 0 80px;
            background: var(--dark);
        }
        .hero-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            background:
                url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1600&q=80') center/cover no-repeat;
            opacity: 0.3;
        }
        .hero-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(10, 10, 26, 0.85) 0%, rgba(0, 123, 255, 0.15) 100%);
        }
        .hero .container {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }
        .hero-content h1 {
            font-size: clamp(2.6rem, 5vw, 4.2rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #fff 60%, var(--primary-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-content .tagline {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 300;
            letter-spacing: 2px;
        }
        .hero-content .tagline span {
            color: var(--primary);
            font-weight: 600;
        }
        .hero-content p {
            font-size: 1.15rem;
            color: var(--text-muted);
            max-width: 520px;
            margin-bottom: 36px;
            line-height: 1.8;
        }
        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
        }
        .hero-image {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .hero-image .floating-card {
            width: 100%;
            max-width: 500px;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid var(--glass-border);
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            animation: float 6s ease-in-out infinite;
        }
        .hero-image .floating-card img {
            width: 100%;
            height: auto;
            display: block;
        }
        .hero-image .floating-badge {
            position: absolute;
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.85rem;
            color: var(--text-light);
            box-shadow: var(--shadow);
            animation: float 8s ease-in-out infinite;
        }
        .hero-image .floating-badge.b1 {
            top: -10px;
            right: -10px;
            animation-delay: 0s;
        }
        .hero-image .floating-badge.b2 {
            bottom: 20px;
            left: -20px;
            animation-delay: 2s;
        }
        .hero-image .floating-badge i {
            color: var(--primary);
            font-size: 1.2rem;
        }

        @keyframes float {
            0%,
            100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-16px);
            }
        }

        .scroll-indicator {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            animation: bounce-down 2s ease-in-out infinite;
        }
        .scroll-indicator .mouse {
            width: 24px;
            height: 38px;
            border: 2px solid var(--text-muted);
            border-radius: 12px;
            position: relative;
        }
        .scroll-indicator .mouse::after {
            content: '';
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            width: 4px;
            height: 10px;
            background: var(--primary);
            border-radius: 4px;
            animation: scroll-mouse 2s ease-in-out infinite;
        }
        @keyframes scroll-mouse {
            0%,
            100% {
                transform: translateX(-50%) translateY(0);
                opacity: 1;
            }
            50% {
                transform: translateX(-50%) translateY(12px);
                opacity: 0.3;
            }
        }
        @keyframes bounce-down {
            0%,
            100% {
                transform: translateX(-50%) translateY(0);
            }
            50% {
                transform: translateX(-50%) translateY(8px);
            }
        }

        /* Particles */
        .particles {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
        }
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: var(--primary);
            border-radius: 50%;
            opacity: 0.3;
            animation: particle-float 20s linear infinite;
        }
        @keyframes particle-float {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 0.3;
            }
            90% {
                opacity: 0.3;
            }
            100% {
                transform: translateY(-10vh) rotate(720deg);
                opacity: 0;
            }
        }

        /* ============================================================
           SECTIONS
        ============================================================ */
        .section {
            padding: 100px 0;
            position: relative;
        }
        .section-dark {
            background: var(--dark);
        }
        .section-light {
            background: var(--light-gray);
            color: var(--text-dark);
        }
        .section-light .section-label,
        .section-light .section-title,
        .section-light .section-sub {
            color: var(--text-dark);
        }
        .section-light .section-sub {
            color: #4a4a6a;
        }

        .section-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 8px;
        }
        .section-title {
            font-size: clamp(2rem, 3.5vw, 3rem);
            font-weight: 800;
            margin-bottom: 16px;
            line-height: 1.2;
        }
        .section-title span {
            color: var(--primary);
        }
        .section-sub {
            font-size: 1.05rem;
            color: var(--text-muted);
            max-width: 600px;
            line-height: 1.8;
        }
        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }
        .section-header .section-sub {
            margin: 0 auto;
        }

        /* ============================================================
           ABOUT
        ============================================================ */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }
        .about-image {
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid var(--glass-border);
        }
        .about-image img {
            width: 100%;
            height: 400px;
            object-fit: cover;
            transition: transform 0.6s;
        }
        .about-image:hover img {
            transform: scale(1.03);
        }
        .about-content .about-text {
            color: var(--text-muted);
            line-height: 1.9;
            margin-bottom: 20px;
        }
        .about-values {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 20px;
        }
        .about-values .value {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            text-align: center;
            font-size: 0.85rem;
            font-weight: 500;
            backdrop-filter: blur(4px);
            transition: 0.3s;
        }
        .about-values .value:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        /* ============================================================
           SERVICES (Grid)
        ============================================================ */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 28px;
        }
        .service-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            padding: 32px 20px;
            text-align: center;
            transition: 0.4s ease;
            cursor: default;
            position: relative;
            overflow: hidden;
        }
        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), #00d4ff);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.5s ease;
        }
        .service-card:hover::before {
            transform: scaleX(1);
        }
        .service-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
            box-shadow: 0 20px 60px rgba(0, 123, 255, 0.15);
        }
        .service-card .icon {
            font-size: 2.6rem;
            color: var(--primary);
            margin-bottom: 16px;
            display: block;
        }
        .service-card h3 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .service-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 18px;
        }
        .service-card .learn-more {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--primary);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: 0.3s;
            cursor: pointer;
        }
        .service-card .learn-more i {
            transition: 0.3s;
        }
        .service-card:hover .learn-more i {
            transform: translateX(6px);
        }

        /* ============================================================
           WHY CHOOSE US
        ============================================================ */
        .why-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 24px;
            text-align: center;
        }
        .why-item {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            padding: 24px 16px;
            backdrop-filter: blur(8px);
            transition: 0.3s;
        }
        .why-item:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
            box-shadow: var(--shadow-light);
        }
        .why-item .number {
            font-size: 2.8rem;
            font-weight: 900;
            color: var(--primary);
            line-height: 1;
        }
        .why-item .label {
            font-size: 0.95rem;
            font-weight: 500;
            margin-top: 6px;
        }

        /* ============================================================
           PORTFOLIO
        ============================================================ */
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 24px;
        }
        .portfolio-item {
            border-radius: var(--radius-sm);
            overflow: hidden;
            position: relative;
            cursor: pointer;
            aspect-ratio: 4/3;
            background: var(--dark-surface);
            border: 1px solid var(--glass-border);
            transition: 0.4s;
        }
        .portfolio-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }
        .portfolio-item:hover img {
            transform: scale(1.08);
        }
        .portfolio-item .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(0, 123, 255, 0.7), rgba(0, 0, 0, 0.7));
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: 0.4s;
            padding: 20px;
            text-align: center;
        }
        .portfolio-item:hover .overlay {
            opacity: 1;
        }
        .portfolio-item .overlay h4 {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .portfolio-item .overlay p {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.7);
        }
        .portfolio-item .overlay i {
            font-size: 2rem;
            margin-bottom: 12px;
            color: #fff;
        }

        /* Lightbox */
        .lightbox {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(0, 0, 0, 0.92);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: 0.4s;
        }
        .lightbox.active {
            opacity: 1;
            visibility: visible;
        }
        .lightbox img {
            max-width: 90%;
            max-height: 80vh;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow);
            transform: scale(0.9);
            transition: 0.4s;
        }
        .lightbox.active img {
            transform: scale(1);
        }
        .lightbox .close-lightbox {
            position: absolute;
            top: 30px;
            right: 40px;
            font-size: 2.5rem;
            color: #fff;
            cursor: pointer;
            transition: 0.3s;
        }
        .lightbox .close-lightbox:hover {
            color: var(--primary);
            transform: rotate(90deg);
        }

        /* ============================================================
           PROCESS
        ============================================================ */
        .process-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 30px;
            position: relative;
        }
        .process-step {
            text-align: center;
            position: relative;
            padding: 20px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            backdrop-filter: blur(8px);
            transition: 0.3s;
        }
        .process-step:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
        }
        .process-step .step-num {
            font-size: 2.8rem;
            font-weight: 900;
            color: var(--primary);
            opacity: 0.2;
            position: absolute;
            top: 10px;
            right: 16px;
        }
        .process-step .step-icon {
            font-size: 2.4rem;
            color: var(--primary);
            margin-bottom: 12px;
            display: block;
        }
        .process-step h4 {
            font-size: 1.1rem;
            font-weight: 700;
        }
        .process-step p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* ============================================================
           FAQ
        ============================================================ */
        .faq-list {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .faq-item {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            overflow: hidden;
            backdrop-filter: blur(8px);
            transition: 0.3s;
        }
        .faq-item:hover {
            border-color: var(--primary);
        }
        .faq-item .faq-question {
            padding: 18px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            transition: 0.3s;
            user-select: none;
        }
        .faq-item .faq-question:hover {
            color: var(--primary);
        }
        .faq-item .faq-question i {
            transition: 0.4s;
            color: var(--primary);
        }
        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }
        .faq-item .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease, padding 0.4s ease;
            padding: 0 24px;
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.8;
        }
        .faq-item.active .faq-answer {
            max-height: 300px;
            padding: 0 24px 20px;
        }

        /* ============================================================
           CONTACT
        ============================================================ */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
        }
        .contact-info h3 {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .contact-info p {
            color: var(--text-muted);
            margin-bottom: 24px;
        }
        .contact-info .contact-item {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
            padding: 14px 18px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            transition: 0.3s;
        }
        .contact-info .contact-item:hover {
            border-color: var(--primary);
        }
        .contact-info .contact-item i {
            font-size: 1.4rem;
            color: var(--primary);
            width: 36px;
            text-align: center;
        }
        .contact-info .contact-item .text {
            font-weight: 500;
        }
        .contact-info .contact-item .sub {
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .contact-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
        }
        .contact-buttons .btn {
            padding: 12px 24px;
            font-size: 0.9rem;
        }

        .contact-form {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            padding: 36px 32px;
            backdrop-filter: blur(12px);
        }
        .contact-form .form-group {
            margin-bottom: 18px;
        }
        .contact-form label {
            display: block;
            font-weight: 500;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }
        .contact-form input,
        .contact-form textarea,
        .contact-form select {
            width: 100%;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            color: var(--text-light);
            font-family: var(--font);
            font-size: 0.95rem;
            transition: 0.3s;
            outline: none;
        }
        .contact-form input:focus,
        .contact-form textarea:focus,
        .contact-form select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
        }
        .contact-form textarea {
            resize: vertical;
            min-height: 120px;
        }
        .contact-form .btn {
            width: 100%;
            justify-content: center;
        }
        .contact-form select option {
            background: var(--dark);
        }

        /* ============================================================
           FOOTER
        ============================================================ */
        .footer {
            background: var(--dark-surface);
            border-top: 1px solid var(--glass-border);
            padding: 60px 0 30px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }
        .footer-brand .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            cursor: pointer;
        }
        .footer-brand .logo .logo-text .main {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--white);
        }
        .footer-brand .logo .logo-text .main span {
            color: var(--primary);
        }
        .footer-brand .logo .logo-text .sub {
            font-size: 0.6rem;
            letter-spacing: 4px;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .footer-brand .logo .logo-text .tagline {
            font-size: 0.55rem;
            letter-spacing: 2px;
            color: var(--primary);
            text-transform: uppercase;
        }
        .footer-brand .logo .logo-icon {
            font-size: 2rem;
            color: var(--primary);
        }
        .footer-brand p {
            color: var(--text-muted);
            font-size: 0.95rem;
            max-width: 300px;
            line-height: 1.8;
        }
        .footer-brand .social-links {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }
        .footer-brand .social-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-muted);
            transition: 0.3s;
        }
        .footer-brand .social-links a:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
            transform: translateY(-4px);
        }

        .footer-links h4 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 16px;
        }
        .footer-links ul li {
            margin-bottom: 10px;
        }
        .footer-links ul li a {
            color: var(--text-muted);
            font-size: 0.9rem;
            transition: 0.3s;
            cursor: pointer;
        }
        .footer-links ul li a:hover {
            color: var(--primary);
            padding-left: 4px;
        }

        .footer-bottom {
            border-top: 1px solid var(--glass-border);
            padding-top: 24px;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .footer-bottom a {
            color: var(--text-muted);
            transition: 0.3s;
            cursor: pointer;
        }
        .footer-bottom a:hover {
            color: var(--primary);
        }

        /* ============================================================
           STICKY BUTTONS
        ============================================================ */
        .sticky-buttons {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .sticky-buttons a,
        .sticky-buttons button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            color: #fff;
            font-size: 1.4rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
            transition: 0.3s;
            border: none;
            cursor: pointer;
        }
        .sticky-buttons a:hover,
        .sticky-buttons button:hover {
            transform: scale(1.1);
        }
        .sticky-buttons .whatsapp {
            background: #25d366;
        }
        .sticky-buttons .call {
            background: var(--primary);
        }
        .sticky-buttons .back-top {
            background: var(--dark-surface);
            border: 1px solid var(--glass-border);
            color: var(--text-light);
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: 0.4s;
        }
        .sticky-buttons .back-top.visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .sticky-buttons .back-top:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

        /* ============================================================
           COOKIE BANNER
        ============================================================ */
        .cookie-banner {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 9998;
            background: rgba(10, 10, 26, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--glass-border);
            padding: 20px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            transform: translateY(100%);
            transition: transform 0.5s ease;
        }
        .cookie-banner.show {
            transform: translateY(0);
        }
        .cookie-banner p {
            font-size: 0.9rem;
            color: var(--text-muted);
            flex: 1;
            min-width: 200px;
        }
        .cookie-banner .cookie-buttons {
            display: flex;
            gap: 12px;
        }
        .cookie-banner .cookie-buttons .btn {
            padding: 10px 24px;
            font-size: 0.85rem;
        }

        /* ============================================================
           SCROLL PROGRESS
        ============================================================ */
        .scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), #00d4ff);
            z-index: 99999;
            width: 0%;
            transition: width 0.1s linear;
        }

        /* ============================================================
           SERVICE DETAIL PAGES
        ============================================================ */
        .service-detail-hero {
            padding: 160px 0 80px;
            background: var(--dark);
            position: relative;
            overflow: hidden;
        }
        .service-detail-hero .bg {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(0, 123, 255, 0.1), transparent);
            opacity: 0.5;
        }
        .service-detail-hero .container {
            position: relative;
            z-index: 2;
        }
        .service-detail-hero h1 {
            font-size: clamp(2.4rem, 4vw, 3.6rem);
            font-weight: 900;
            margin-bottom: 16px;
        }
        .service-detail-hero h1 span {
            color: var(--primary);
        }
        .service-detail-hero p {
            font-size: 1.1rem;
            color: var(--text-muted);
            max-width: 600px;
            line-height: 1.8;
        }
        .service-detail-hero .breadcrumb {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 20px;
        }
        .service-detail-hero .breadcrumb a {
            color: var(--primary);
        }
        .service-detail-hero .breadcrumb span {
            color: var(--text-muted);
        }

        .service-features {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 24px;
            margin: 40px 0;
        }
        .service-features .feature {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            padding: 24px 20px;
            text-align: center;
            transition: 0.3s;
        }
        .service-features .feature:hover {
            border-color: var(--primary);
            transform: translateY(-4px);
        }
        .service-features .feature i {
            font-size: 2.4rem;
            color: var(--primary);
            margin-bottom: 12px;
            display: block;
        }
        .service-features .feature h4 {
            font-size: 1rem;
            font-weight: 700;
        }
        .service-features .feature p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* ============================================================
           FREE CONSULTATION PAGE
        ============================================================ */
        .consultation-hero {
            padding: 160px 0 60px;
            background: var(--dark);
            position: relative;
            overflow: hidden;
        }
        .consultation-hero .bg {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(0, 123, 255, 0.08), transparent);
        }
        .consultation-hero .container {
            position: relative;
            z-index: 2;
        }
        .consultation-hero h1 {
            font-size: clamp(2.4rem, 4vw, 3.6rem);
            font-weight: 900;
            margin-bottom: 16px;
        }
        .consultation-hero h1 span {
            color: var(--primary);
        }
        .consultation-hero p {
            font-size: 1.1rem;
            color: var(--text-muted);
            max-width: 600px;
            line-height: 1.8;
        }

        .consultation-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
            padding: 60px 0 100px;
        }
        .consultation-benefits {
            padding-top: 20px;
        }
        .consultation-benefits h3 {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 20px;
        }
        .consultation-benefits .benefit {
            display: flex;
            gap: 16px;
            align-items: flex-start;
            margin-bottom: 20px;
            padding: 16px 18px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            transition: 0.3s;
        }
        .consultation-benefits .benefit:hover {
            border-color: var(--primary);
        }
        .consultation-benefits .benefit i {
            font-size: 1.4rem;
            color: var(--primary);
            margin-top: 4px;
        }
        .consultation-benefits .benefit .text h4 {
            font-weight: 600;
            font-size: 1rem;
        }
        .consultation-benefits .benefit .text p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .consultation-form-wrapper {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            padding: 36px 32px;
            backdrop-filter: blur(12px);
        }
        .consultation-form-wrapper .form-group {
            margin-bottom: 18px;
        }
        .consultation-form-wrapper label {
            display: block;
            font-weight: 500;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }
        .consultation-form-wrapper input,
        .consultation-form-wrapper textarea,
        .consultation-form-wrapper select {
            width: 100%;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            color: var(--text-light);
            font-family: var(--font);
            font-size: 0.95rem;
            transition: 0.3s;
            outline: none;
        }
        .consultation-form-wrapper input:focus,
        .consultation-form-wrapper textarea:focus,
        .consultation-form-wrapper select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
        }
        .consultation-form-wrapper textarea {
            resize: vertical;
            min-height: 100px;
        }
        .consultation-form-wrapper select option {
            background: var(--dark);
        }
        .consultation-form-wrapper .btn {
            width: 100%;
            justify-content: center;
        }
        .consultation-form-wrapper .whatsapp-btn {
            margin-top: 12px;
            width: 100%;
            justify-content: center;
            background: #25d366;
            color: #fff;
            border: none;
        }
        .consultation-form-wrapper .whatsapp-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 40px rgba(37, 211, 102, 0.4);
        }

        .thank-you-message {
            display: none;
            text-align: center;
            padding: 40px 20px;
        }
        .thank-you-message.show {
            display: block;
            animation: fadeInPage 0.6s ease forwards;
        }
        .thank-you-message i {
            font-size: 4rem;
            color: #10b981;
            margin-bottom: 20px;
        }
        .thank-you-message h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .thank-you-message p {
            color: var(--text-muted);
            max-width: 400px;
            margin: 0 auto;
        }

        /* ============================================================
           RESPONSIVE
        ============================================================ */
        @media (max-width: 1024px) {
            .hero .container,
            .about-grid,
            .contact-grid,
            .consultation-grid {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .hero-content p,
            .consultation-hero p {
                margin: 0 auto 30px;
            }
            .hero-buttons,
            .contact-buttons {
                justify-content: center;
            }
            .about-values {
                justify-content: center;
            }
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
            .nav-links {
                display: none;
            }
            .hamburger {
                display: flex;
            }
            .nav-actions .theme-toggle {
                display: none;
            }
            .hero-image .floating-badge.b1 {
                top: -10px;
                right: 0;
            }
            .hero-image .floating-badge.b2 {
                bottom: 10px;
                left: 0;
            }
            .consultation-benefits .benefit {
                text-align: left;
            }
            .service-detail-hero h1 {
                font-size: 2.2rem;
            }
        }

        @media (max-width: 640px) {
            .section,
            .consultation-grid {
                padding: 60px 0;
            }
            .hero {
                padding: 100px 0 60px;
                min-height: 90vh;
            }
            .hero-content h1 {
                font-size: 2.2rem;
            }
            .hero-content p {
                font-size: 1rem;
            }
            .hero-image .floating-card {
                max-width: 300px;
            }
            .hero-image .floating-badge {
                padding: 8px 14px;
                font-size: 0.7rem;
            }
            .hero-image .floating-badge i {
                font-size: 1rem;
            }
            .hero-image .floating-badge.b1 {
                top: -6px;
                right: 0;
            }
            .hero-image .floating-badge.b2 {
                bottom: 4px;
                left: 0;
            }
            .services-grid {
                grid-template-columns: 1fr 1fr;
            }
            .portfolio-grid {
                grid-template-columns: 1fr 1fr;
            }
            .process-grid {
                grid-template-columns: 1fr 1fr;
            }
            .why-grid {
                grid-template-columns: 1fr 1fr;
            }
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            .contact-form,
            .consultation-form-wrapper {
                padding: 24px 18px;
            }
            .about-image img {
                height: 250px;
            }
            .sticky-buttons {
                bottom: 20px;
                right: 16px;
            }
            .sticky-buttons a,
            .sticky-buttons button {
                width: 48px;
                height: 48px;
                font-size: 1.2rem;
            }
            .cookie-banner {
                flex-direction: column;
                text-align: center;
                padding: 16px 20px;
            }
            .cookie-banner .cookie-buttons {
                width: 100%;
                justify-content: center;
            }
            .scroll-indicator {
                display: none;
            }
            .about-values {
                grid-template-columns: 1fr 1fr;
            }
            .service-detail-hero {
                padding: 120px 0 60px;
            }
            .consultation-hero {
                padding: 120px 0 40px;
            }
            .service-features {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 480px) {
            .services-grid,
            .portfolio-grid,
            .process-grid,
            .service-features {
                grid-template-columns: 1fr;
            }
            .why-grid {
                grid-template-columns: 1fr 1fr;
            }
            .hero-content h1 {
                font-size: 1.9rem;
            }
            .hero-buttons .btn,
            .contact-buttons .btn {
                width: 100%;
                justify-content: center;
            }
            .about-values {
                grid-template-columns: 1fr;
            }
            .consultation-hero h1 {
                font-size: 1.8rem;
            }
        }

        /* ============================================================
           LIGHT MODE OVERRIDES
        ============================================================ */
        body.light-mode {
            background: var(--light-gray);
            color: var(--text-dark);
        }
        body.light-mode .header.scrolled {
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        }
        body.light-mode .header:not(.scrolled) {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
        }
        body.light-mode .logo .logo-text .main {
            color: var(--text-dark);
        }
        body.light-mode .logo .logo-text .main span {
            color: var(--primary);
        }
        body.light-mode .nav-links a {
            color: var(--text-dark);
        }
        body.light-mode .hero-bg {
            opacity: 0.15;
        }
        body.light-mode .hero-bg::after {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(0, 123, 255, 0.08) 100%);
        }
        body.light-mode .hero-content h1 {
            background: linear-gradient(135deg, #1a1a2e 60%, var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        body.light-mode .service-card,
        body.light-mode .why-item,
        body.light-mode .process-step,
        body.light-mode .faq-item,
        body.light-mode .contact-form,
        body.light-mode .contact-info .contact-item,
        body.light-mode .about-values .value,
        body.light-mode .consultation-form-wrapper,
        body.light-mode .consultation-benefits .benefit,
        body.light-mode .service-features .feature {
            background: rgba(255, 255, 255, 0.7);
            border-color: rgba(0, 0, 0, 0.06);
        }
        body.light-mode .section-dark,
        body.light-mode .service-detail-hero,
        body.light-mode .consultation-hero {
            background: var(--light-gray);
        }
        body.light-mode .section-light {
            background: #ffffff;
        }
        body.light-mode .footer {
            background: #ffffff;
            border-color: rgba(0, 0, 0, 0.06);
        }
        body.light-mode .footer-brand .logo .logo-text .main {
            color: var(--text-dark);
        }
        body.light-mode .footer-brand p,
        body.light-mode .footer-links ul li a,
        body.light-mode .footer-bottom {
            color: #4a4a6a;
        }
        body.light-mode .contact-form input,
        body.light-mode .contact-form textarea,
        body.light-mode .consultation-form-wrapper input,
        body.light-mode .consultation-form-wrapper textarea,
        body.light-mode .consultation-form-wrapper select {
            background: rgba(0, 0, 0, 0.03);
            color: var(--text-dark);
            border-color: rgba(0, 0, 0, 0.08);
        }
        body.light-mode .contact-form input:focus,
        body.light-mode .contact-form textarea:focus,
        body.light-mode .consultation-form-wrapper input:focus,
        body.light-mode .consultation-form-wrapper textarea:focus,
        body.light-mode .consultation-form-wrapper select:focus {
            border-color: var(--primary);
        }
        body.light-mode .mobile-menu {
            background: rgba(255, 255, 255, 0.98);
        }
        body.light-mode .mobile-menu a {
            color: var(--text-dark);
            border-color: rgba(0, 0, 0, 0.05);
        }
        body.light-mode .btn-secondary {
            border-color: rgba(0, 0, 0, 0.15);
            color: var(--text-dark);
        }
        body.light-mode .btn-secondary:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: rgba(0, 123, 255, 0.05);
        }
        body.light-mode .theme-toggle {
            background: rgba(0, 0, 0, 0.04);
            border-color: rgba(0, 0, 0, 0.08);
            color: var(--text-dark);
        }
        body.light-mode .hamburger span {
            background: var(--text-dark);
        }
        body.light-mode .sticky-buttons .back-top {
            background: #fff;
            border-color: rgba(0, 0, 0, 0.08);
            color: var(--text-dark);
        }
        body.light-mode .cookie-banner {
            background: rgba(255, 255, 255, 0.95);
            border-color: rgba(0, 0, 0, 0.06);
        }
        body.light-mode .cookie-banner p {
            color: var(--text-dark);
        }
        body.light-mode .section-sub,
        body.light-mode .about-content .about-text,
        body.light-mode .service-detail-hero p,
        body.light-mode .consultation-hero p,
        body.light-mode .consultation-benefits .benefit .text p {
            color: #4a4a6a;
        }
        body.light-mode .portfolio-item {
            background: #fff;
            border-color: rgba(0, 0, 0, 0.06);
        }
        body.light-mode .scroll-progress {
            background: linear-gradient(90deg, var(--primary), #4da3ff);
        }
        body.light-mode #loader {
            background: var(--light-gray);
        }
        body.light-mode #loader .logo-load .main {
            -webkit-text-fill-color: var(--primary);
        }
        body.light-mode .section-label {
            color: var(--primary);
        }
        body.light-mode .section-title span,
        body.light-mode .service-detail-hero h1 span,
        body.light-mode .consultation-hero h1 span {
            color: var(--primary);
        }
        body.light-mode .consultation-form-wrapper select option {
            background: #fff;
            color: var(--text-dark);
        }
        body.light-mode .service-detail-hero .bg {
            background: linear-gradient(135deg, rgba(0, 123, 255, 0.05), transparent);
        }
        body.light-mode .consultation-hero .bg {
            background: linear-gradient(135deg, rgba(0, 123, 255, 0.05), transparent);
        }
    </style>
</head>
<body>

    <!-- ============================================================
    LOADING SCREEN
    ============================================================ -->
    <div id="loader" role="status" aria-label="Loading">
        <div class="logo-load">
            <div class="main">Nami</div>
            <div class="sub">CREATIVE DIGITAL MARKETING</div>
            <div class="tagline">RIDE THE WAVE OF GROWTH</div>
        </div>
        <div class="loader-bar"></div>
    </div>

    <!-- ============================================================
    SCROLL PROGRESS
    ============================================================ -->
    <div class="scroll-progress" id="scrollProgress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

    <!-- ============================================================
    HEADER
    ============================================================ -->
    <header class="header" id="header" role="banner">
        <div class="container">
            <a class="logo" data-page="home" aria-label="Nami Home">
                <span class="logo-icon">🌊</span>
                <div class="logo-text">
                    <span class="main">Nam<span>i</span></span>
                    <span class="sub">CREATIVE DIGITAL MARKETING</span>
                    <span class="tagline">RIDE THE WAVE OF GROWTH</span>
                </div>
            </a>

            <nav class="nav-links" role="navigation" aria-label="Main Navigation">
                <a data-page="home" class="active">Home</a>
                <a data-page="about">About</a>
                <a data-page="services">Services</a>
                <a data-page="portfolio">Portfolio</a>
                <a data-page="process">Process</a>
                <a data-page="faq">FAQ</a>
                <a data-page="contact">Contact</a>
                <a data-page="consultation" style="color:var(--primary);font-weight:600;">Free Consultation</a>
            </nav>

            <div class="nav-actions">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <i class="fas fa-moon"></i>
                </button>
                <div class="hamburger" id="hamburger" role="button" aria-label="Toggle menu" tabindex="0">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="overlay" id="overlay"></div>
    <nav class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Mobile Navigation">
        <a data-page="home">Home</a>
        <a data-page="about">About</a>
        <a data-page="services">Services</a>
        <a data-page="portfolio">Portfolio</a>
        <a data-page="process">Process</a>
        <a data-page="faq">FAQ</a>
        <a data-page="contact">Contact</a>
        <a data-page="consultation" style="color:var(--primary);font-weight:600;">Free Consultation</a>
        <div class="mobile-social">
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
            <a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
        </div>
    </nav>

    <!-- ============================================================
    PAGE: HOME
    ============================================================ -->
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Excellence – Hero</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <style>
        /* ─── Reset & Base ─── */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6c3bf1;
            --primary-dark: #4a1f9e;
            --primary-gradient: linear-gradient(135deg, #6c3bf1 0%, #a855f7 100%);
            --text-light: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.85);
            --bg-dark: #0a0618;
            --shadow-heavy: 0 25px 60px rgba(0, 0, 0, 0.5);
            --radius-card: 24px;
            --transition-smooth: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 40px;
            position: relative;
            z-index: 2;
        }

        /* ─── Hero Section ─── */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 80px 0 60px;
            overflow: hidden;
            background: var(--bg-dark);
        }

        /* Hero Background with gradient + subtle noise */
        .hero-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(108, 59, 241, 0.25) 0%, transparent 70%),
                radial-gradient(ellipse 60% 50% at 90% 20%, rgba(168, 85, 247, 0.20) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 50% 50%, rgba(108, 59, 241, 0.06) 0%, transparent 70%),
                var(--bg-dark);
        }

        .hero-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
            opacity: 0.5;
            pointer-events: none;
        }

        /* ─── Particles ─── */
        .particles {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
        }

        .particles::before,
        .particles::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.3) 0%, transparent 70%);
            animation: floatParticle 18s infinite alternate ease-in-out;
        }

        .particles::before {
            width: 300px;
            height: 300px;
            top: 10%;
            left: -5%;
            animation-delay: 0s;
        }

        .particles::after {
            width: 400px;
            height: 400px;
            bottom: 10%;
            right: -8%;
            background: radial-gradient(circle, rgba(108, 59, 241, 0.2) 0%, transparent 70%);
            animation-delay: -6s;
        }

        @keyframes floatParticle {
            0% {
                transform: translate(0, 0) scale(1);
            }
            100% {
                transform: translate(40px, -30px) scale(1.2);
            }
        }

        /* ─── Hero Content ─── */
        .hero-content {
            position: relative;
            z-index: 2;
            flex: 1 1 55%;
            padding-right: 40px;
        }

        .tagline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.7);
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 8px 20px 8px 16px;
            border-radius: 100px;
            margin-bottom: 28px;
            display: inline-flex;
            transition: var(--transition-smooth);
        }

        .tagline:hover {
            background: rgba(255, 255, 255, 0.10);
            border-color: rgba(168, 85, 247, 0.3);
        }

        .tagline span {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ─── H1 ─── */
        .hero-content h1 {
            font-size: clamp(2.6rem, 6vw, 4.8rem);
            font-weight: 800;
            line-height: 1.08;
            letter-spacing: -0.03em;
            color: #fff;
            margin-bottom: 16px;
            background: linear-gradient(135deg, #ffffff 50%, #c4b5fd 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: none;
            max-width: 800px;
        }

        /* ─── H2 ─── */
        .hero-content h2 {
            font-size: clamp(1.1rem, 1.6vw, 1.6rem);
            font-weight: 400;
            line-height: 1.5;
            color: rgba(255, 255, 255, 0.75);
            margin-bottom: 20px;
            max-width: 620px;
            letter-spacing: 0.01em;
            border-left: 3px solid rgba(168, 85, 247, 0.4);
            padding-left: 20px;
            font-weight: 300;
        }

        .hero-content h2 strong {
            color: #fff;
            font-weight: 500;
        }

        /* ─── Paragraph ─── */
        .hero-content p {
            font-size: clamp(1rem, 1.2vw, 1.2rem);
            line-height: 1.7;
            color: var(--text-muted);
            max-width: 560px;
            margin-bottom: 36px;
            font-weight: 300;
        }

        /* ─── Buttons ─── */
        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: center;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 16px 34px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            cursor: pointer;
            transition: var(--transition-smooth);
            border: none;
            background: transparent;
            color: #fff;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.01em;
        }

        .btn-primary {
            background: var(--primary-gradient);
            color: #fff;
            box-shadow: 0 8px 32px rgba(108, 59, 241, 0.35);
        }

        .btn-primary:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 14px 48px rgba(108, 59, 241, 0.50);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #fff;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.14);
            border-color: rgba(168, 85, 247, 0.3);
            transform: translateY(-3px);
        }

        .btn i {
            transition: transform 0.3s ease;
        }

        .btn:hover i {
            transform: translateX(4px);
        }

        .btn-ripple {
            position: relative;
            overflow: hidden;
        }

        /* ─── Hero Image ─── */
        .hero-image {
            flex: 1 1 40%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 380px;
        }

        .floating-card {
            position: relative;
            border-radius: var(--radius-card);
            overflow: hidden;
            box-shadow: var(--shadow-heavy);
            transform: perspective(1200px) rotateY(-4deg) rotateX(3deg);
            transition: transform 0.6s ease;
            max-width: 100%;
        }

        .floating-card:hover {
            transform: perspective(1200px) rotateY(-2deg) rotateX(2deg) scale(1.01);
        }

        .floating-card img {
            display: block;
            width: 100%;
            height: auto;
            border-radius: var(--radius-card);
            object-fit: cover;
            aspect-ratio: 3/2;
        }

        .floating-card::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: var(--radius-card);
            background: linear-gradient(135deg, rgba(108, 59, 241, 0.15) 0%, transparent 60%);
            pointer-events: none;
        }

        /* Floating Badges */
        .floating-badge {
            position: absolute;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.10);
            padding: 12px 22px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #fff;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
            animation: floatBadge 6s infinite alternate ease-in-out;
            z-index: 3;
        }

        .floating-badge i {
            font-size: 1.1rem;
            color: #a855f7;
        }

        .floating-badge.b1 {
            top: 5%;
            right: -5%;
            animation-delay: 0s;
        }

        .floating-badge.b2 {
            bottom: 8%;
            left: -8%;
            animation-delay: -3s;
        }

        @keyframes floatBadge {
            0% {
                transform: translateY(0px) scale(1);
            }
            100% {
                transform: translateY(-14px) scale(1.04);
            }
        }

        /* ─── Scroll Indicator ─── */
        .scroll-indicator {
            position: absolute;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            opacity: 0.5;
            transition: opacity 0.4s ease;
        }

        .scroll-indicator:hover {
            opacity: 1;
        }

        .scroll-indicator .mouse {
            width: 26px;
            height: 40px;
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            position: relative;
        }

        .scroll-indicator .mouse::after {
            content: '';
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            width: 4px;
            height: 8px;
            background: #a855f7;
            border-radius: 4px;
            animation: scrollWheel 2.2s infinite ease-in-out;
        }

        .scroll-indicator span {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255, 255, 255, 0.35);
        }

        @keyframes scrollWheel {
            0%,
            100% {
                transform: translateX(-50%) translateY(0);
                opacity: 1;
            }
            50% {
                transform: translateX(-50%) translateY(12px);
                opacity: 0.3;
            }
        }

        /* ─── Responsive ─── */
        @media (max-width: 1024px) {
            .hero .container {
                flex-direction: column;
                gap: 40px;
            }

            .hero-content {
                padding-right: 0;
                text-align: center;
            }

            .hero-content h1 {
                max-width: 100%;
            }

            .hero-content h2 {
                max-width: 100%;
                border-left: none;
                padding-left: 0;
                text-align: center;
            }

            .hero-content p {
                max-width: 100%;
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons {
                justify-content: center;
            }

            .hero-image {
                flex: 1 1 auto;
                width: 100%;
                min-height: 300px;
            }

            .floating-card {
                max-width: 480px;
                margin: 0 auto;
                transform: none;
            }

            .floating-card:hover {
                transform: scale(1.01);
            }

            .floating-badge.b1 {
                right: 2%;
                top: 2%;
            }

            .floating-badge.b2 {
                left: 2%;
                bottom: 4%;
            }

            .tagline {
                margin-left: auto;
                margin-right: auto;
            }
        }

        @media (max-width: 640px) {
            .container {
                padding: 0 20px;
            }

            .hero {
                padding: 60px 0 40px;
                min-height: 90vh;
            }

            .hero-content h1 {
                font-size: clamp(2rem, 10vw, 2.8rem);
            }

            .hero-content h2 {
                font-size: 1rem;
                padding-left: 0;
                border-left: none;
            }

            .hero-content p {
                font-size: 0.95rem;
            }

            .btn {
                padding: 14px 24px;
                font-size: 0.9rem;
                width: 100%;
                justify-content: center;
            }

            .hero-buttons {
                flex-direction: column;
                width: 100%;
            }

            .floating-badge {
                padding: 8px 16px;
                font-size: 0.75rem;
                gap: 6px;
            }

            .floating-badge i {
                font-size: 0.9rem;
            }

            .floating-badge.b1 {
                top: 0;
                right: 0;
            }

            .floating-badge.b2 {
                bottom: 0;
                left: 0;
            }

            .floating-card {
                max-width: 100%;
            }

            .scroll-indicator {
                display: none;
            }
        }

        @media (max-width: 400px) {
            .floating-badge {
                display: none;
            }
        }
    </style>
</head>

<body>

    <section class="hero" id="home" aria-labelledby="hero-title">
